# ==============================================================================
# Careerio Backend Environment Configuration
# ==============================================================================

# Server Port
PORT=5000

# Node Environment (development | production)
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/careerio?retryWrites=true&w=majority

# JWT Secret Key for Authentication
JWT_SECRET=your_jwt_secret_key_here

# Frontend Application URL (for CORS and Invitation Links)
CLIENT_URL=http://localhost:5173

# Email Service (Nodemailer - Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Google OAuth 2.0 (Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# AI Services
# Google Gemini API Key (Gemini 2.5/2.0/1.5)
GEMINI_API_KEY=your_gemini_api_key

# OpenAI API Key (Dùng cho Text-To-Speech trong AI Mock Interview)
OPENAI_API_KEY=your_openai_api_key

# PayOS Payment Gateway (https://payos.vn/)
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
